{
    "Verbosity": {
        "level": 2
    },
    "NeuralNetwork": {
        "Profile": {"enable": 1},
        "Architecture": {
            "model_type": "DimeNet",
            "radius": 7,
            "max_neighbours": 5,
            "num_radial": 5,
            "hidden_dim": 25,
            "num_conv_layers": 2,
            "output_heads": {
                "node": {
                    "num_headlayers": 2, 
                    "dim_headlayers": [20, 20], 
                    "type": "mlp"
                }
            },
            "task_weights": [1.0, 1.0]
        },
        "Variables_of_interest": {
            "input_node_features": [0],
            "output_index": [0, 1],
            "type": ["node", "node"],
            "output_dim": [1, 3],
            "output_names": ["total_energy", "atomic_forces"]
        },
        "Training": {
            "num_epoch": 2,
            "perc_train": 0.8,
            "loss_function_type": "mse",
            "batch_size": 32,
            "patience": 50,
            "EarlyStopping": true,
            "Optimizer":{
                "type": "AdamW",
                "learning_rate": 1e-3
            },
            "compute_grad_energy": true
        }
     },
    "Visualization": {
        "plot_init_solution": true,
        "plot_hist_solution": false,
        "create_plots": true
    }
}
